// src/components/AccountCreation.js
import React, { useState } from 'react';
import axios from 'axios';
import { useNavigate } from 'react-router-dom';

function AccountCreation() {
  const [initialDeposit, setInitialDeposit] = useState(0);
  const [error, setError] = useState('');
  const navigate = useNavigate();

  const handleSubmit = async (e) => {
    e.preventDefault();
    try {
      const response = await axios.post('http://localhost:5000/api/accounts', { initial_deposit: initialDeposit });
      localStorage.setItem('accountId', response.data.accountId);
      navigate('/dashboard');
    } catch (err) {
      setError(err.response?.data?.error || 'Failed to create account');
    }
  };

  return (
    <div>
      <h1>Create Account</h1>
      {error && <p style={{ color: 'red' }}>{error}</p>}
      <form onSubmit={handleSubmit}>
        <label>
          Initial Deposit:
          <input type="number" value={initialDeposit} onChange={e => setInitialDeposit(e.target.value)} />
        </label>
        <button type="submit">Create Account</button>
      </form>
    </div>
  );
}

export default AccountCreation;

