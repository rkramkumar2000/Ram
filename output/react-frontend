```javascript
// src/components/AccountDashboard.js
import React, { useState, useEffect } from 'react';
import axios from 'axios';

function AccountDashboard() {
  const [account, setAccount] = useState(null);
  const [transactionType, setTransactionType] = useState('');
  const [amount, setAmount] = useState(0);
  const [symbol, setSymbol] = useState('');
  const [quantity, setQuantity] = useState(0);
  const [error, setError] = useState('');

  useEffect(() => {
    const fetchAccount = async () => {
      try {
        const accountId = localStorage.getItem('accountId');
        const response = await axios.get(`http://localhost:5000/api/accounts/${accountId}`);
        setAccount(response.data);
      } catch (err) {
        setError('Failed to fetch account data');
      }
    };
    fetchAccount();
  }, []);


  const handleTransaction = async (e) => {
    e.preventDefault();
    try {
      const accountId = localStorage.getItem('accountId');
      const data = { type: transactionType, amount, symbol, quantity };
      const response = await axios.post(`http://localhost:5000/api/accounts/${accountId}/transactions`, data);
      setAccount(response.data);
      setAmount(0);
      setSymbol('');
      setQuantity(0);
      setError('');
    } catch (err) {
      setError(err.response?.data?.error || 'Transaction failed');
    }
  };

  if (!account) {
    return <div>Loading...</div>;
  }

  return (
    <div>
      <h1>Account Dashboard</h1>
      <p>Balance: {account.balance}</p>
      <p>Portfolio Value: {account.portfolioValue}</p>
      <p>Profit/Loss: {account.profitLoss}</p>
      <h2>Holdings:</h2>
      <ul>
        {Object.entries(account.holdings).map(([symbol, quantity]) => (
          <li key={symbol}>{symbol}: {quantity}</li>
        ))}
      </ul>
      <h2>Transactions:</h2>
      <ul>
        {account.transactions.map((transaction, index) => (
          <li key={index}>{JSON.stringify(transaction)}</li>
        ))}
      </ul>

      {error && <p style={{ color: 'red' }}>{error}</p>}
      <form onSubmit={handleTransaction}>
        <label>
          Transaction Type:
          <select value={transactionType} onChange={e => setTransactionType(e.target.value)}>
            <option value="deposit">Deposit</option>
            <option value="withdrawal">Withdrawal</option>
            <option value="buy">Buy</option>
            <option value="sell">Sell</option>
          </select>
        </label>
        {transactionType === 'deposit' || transactionType === 'withdrawal' ? (
          <label>
            Amount:
            <input type="number" value={amount} onChange={e => setAmount(e.target.value)} />
          </label>
        ) : (
          <>
            <label>
              Symbol:
              <input type="text" value={symbol} onChange={e => setSymbol(e.target.value)} />
            </label>
            <label>
              Quantity:
              <input type="number" value={quantity} onChange={e => setQuantity(e.target.value)} />
            </label>
          </>
        )}
        <button type="submit">Submit Transaction</button>
      </form>
    </div>
  );
}

export default AccountDashboard;
